# Maintainer: Dante Ferreira <https://github.com/dante-ferr>
pkgname=walltag
pkgver=0.1.2
pkgrel=1
pkgdesc="Minimalist wallpaper manager and visual gallery for Linux/Wayland"
arch=('x86_64' 'aarch64')
url="https://github.com/dante-ferr/walltag"
license=('MIT')
depends=('gtk4' 'libadwaita' 'gcc-libs')
makedepends=('cargo' 'rustc' 'git')
optdepends=(
  'swww: swww wallpaper backend'
  'awww: awww wallpaper backend'
)
options=(!debug !lto)
source=("$pkgname::git+https://github.com/dante-ferr/walltag.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  # Ensure artifacts land in ./target even if the environment sets CARGO_TARGET_DIR.
  unset CARGO_TARGET_DIR
  cargo build --release --locked
}

package() {
  cd "$pkgname"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "assets/io.github.dante_ferr.Walltag.desktop" \
    "$pkgdir/usr/share/applications/io.github.dante_ferr.Walltag.desktop"
  install -Dm644 "assets/io.github.dante_ferr.Walltag.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.dante_ferr.Walltag.svg"
  install -Dm644 "assets/io.github.dante_ferr.Walltag.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/io.github.dante_ferr.Walltag.metainfo.xml"
}
